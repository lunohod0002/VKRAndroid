<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#ffffff"
    android:paddingBottom="25dp">

    <View
        android:id="@+id/drag_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:background="@color/colorCustomGrey"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/videoPlayerCardPopUp"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="25dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/drag_handle"
        app:strokeWidth="0dp">

        <androidx.media3.ui.PlayerView
            android:id="@+id/videoPlayerPopUp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:keepScreenOn="true"
            app:controller_layout_id="@layout/exo_video_player_controls"
            app:fastforward_icon="@drawable/ic_forward_15"
            app:pause_icon="@drawable/ic_pause"
            app:play_icon="@drawable/ic_play"
            app:resize_mode="zoom"
            app:rewind_icon="@drawable/ic_replay_15"
            app:show_buffering="when_playing"
            app:show_fastforward_button="true"
            app:show_rewind_button="true"
            app:show_timeout="3000"
            app:surface_type="texture_view" />
    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>